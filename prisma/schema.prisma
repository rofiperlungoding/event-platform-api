generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  team      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([team])
}
