generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  team      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([team])
}
